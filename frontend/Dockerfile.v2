FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_V2_SPRING_BOOT_URL=http://localhost:3002/api
ENV VITE_V2_SPRING_BOOT_URL=$VITE_V2_SPRING_BOOT_URL
RUN npm run lint && npx vite build
FROM nginx:stable-alpine
COPY frontend/nginx.v2.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
