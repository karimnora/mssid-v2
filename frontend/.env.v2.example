# Copy to .env.local in the V2 worktree only (do not commit .env.local).
# Generic VITE_SPRING_BOOT_URL is ignored by the V2 Vite build.
VITE_V2_SPRING_BOOT_URL=http://localhost:8081/api
# For an APK or a hosted preview: use your separate HTTPS backend ending in /api.
VITE_V2_GOOGLE_CLIENT_ID=
VITE_V2_SENTRY_DSN=
