{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "audio:index": "tsx scripts/index-recorded-speech.ts",
    "test:e2e": "playwright test",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:init": "cap init \"Mssid DZ - مسيد\" dz.mssid.app --web-dir dist",
    "cap:add": "cap add android",
    "build:android": "node scripts/build-android.mjs",
    "cap:sync": "npm run build:android && cap sync android",
    "cap:sync:dev": "vite build --mode development && cap sync android",
    "cap:open": "cap open android",
    "dev:v2": "node scripts/dev-v2.mjs",
    "build:android:beta": "node scripts/build-android-beta.mjs",
    "cap:sync:beta": "npm run build:android:beta && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capawesome/capacitor-google-sign-in": "^0.1.4",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sentry/react": "^10.71.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.4",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "phaser": "^4.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
