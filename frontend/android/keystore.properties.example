# Copy to keystore.properties (same folder) for a local signed release build — that file is
# gitignored and must never be committed. In CI, the workflow writes this file from GitHub secrets
# instead (see .github/workflows/android-release.yml); local devs don't need this at all for
# `assembleDebug`, only for a signed `assembleRelease` / `bundleRelease`.
#
# storeFile is resolved via rootProject.file(...) in app/build.gradle, i.e. relative to this
# android/ directory — so a keystore placed next to this file needs no "../" prefix.

storeFile=mssid-release-key.jks
storePassword=changeme
keyAlias=mssid-key
keyPassword=changeme
