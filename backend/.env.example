# Variables d'environnement du backend Spring Boot — voir application.properties pour le mapping
# exact (chaque ${VAR:defaut} ci-dessous correspond à une ligne de ce fichier).
#
# Spring Boot NE charge PAS automatiquement un fichier .env (contrairement à Node/dotenv) : ce
# fichier sert de documentation. Pour les utiliser réellement en local, exporte-les dans ton shell
# avant de lancer le backend, ou ajoute-les dans "Environment variables" de ta configuration
# IntelliJ/Run :
#   PowerShell : $env:DATABASE_URL = "jdbc:postgresql://..."
#   Bash       : export DATABASE_URL="jdbc:postgresql://..."
# Sur Render, ce sont les vraies variables d'environnement du service (voir render.yaml à la racine).

# --- Base de données (Neon, ou tout Postgres managé) -----------------------------------------
# Neon te donne une chaîne du style :
#   postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
# Spring veut le préfixe jdbc: et le user/password SÉPARÉS de l'URL :
#   DATABASE_URL      = jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require
#   DATABASE_USERNAME = <user>
#   DATABASE_PASSWORD = <password>
# Sans ces 3 variables, le backend se rabat sur le Postgres local de docker-compose.yml.
DATABASE_URL=jdbc:postgresql://localhost:5432/mssid_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Sécurité JWT ------------------------------------------------------------------------------
# Chaîne aléatoire longue. Une valeur de dev est utilisée par défaut si absente — À NE JAMAIS
# garder en production. Render en génère une automatiquement via render.yaml (generateValue: true).
JWT_SECRET=

# --- Cookies d'authentification ----------------------------------------------------------------
# true + None uniquement quand frontend et backend sont sur des domaines différents en HTTPS
# (ex. Vercel + Render). En local HTTP, laisser false / Strict.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# --- IA (tuteur "المعلم مسيد") -----------------------------------------------------------------
# Clé Gemini — https://aistudio.google.com/apikey. Vide = le tuteur répond proprement
# "تعذر الوصول إلى المعلم الذكي" au lieu de planter (voir GeminiAiService).
GEMINI_API_KEY=

# --- Email transactionnel (confirmation de compte) ----------------------------------------------
# Clé Resend — https://resend.com/api-keys. Vide = l'inscription fonctionne quand même,
# seul l'envoi du code de vérification est silencieusement sauté (voir ResendEmailService).
RESEND_API_KEY=
